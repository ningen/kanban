{
  "name": "kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal task management. Human via Web UI, AI agent via CLI, plain-text Markdown as source of truth.",
  "bin": {
    "kanban": "./src/cli/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "cd src/ui && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:all": "biome check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage-reporter=lcov && bun run scripts/check-coverage.ts",
    "build": "cd src/ui && tsc --noEmit && vite build",
    "quality": "bun run typecheck && bun run typecheck:ui && bun run check:all && bun run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "yaml": "^2.6.0"
  }
}
