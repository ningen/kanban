#!/bin/sh
# Pre-commit quality gate.
#
# Runs typecheck, lint+format check, and unit tests with a coverage threshold
# before a commit is allowed. This blocks low-quality code from entering
# history, matching the project's "fail the build, don't ship sloppy code"
# policy.
#
# To bypass locally, use: git commit --no-verify

set -eu

echo "── kanban: running quality gate (typecheck + biome + tests) ──"

# TypeScript strict type check (backend + frontend).
echo "▶ typecheck (backend + ui)"
bun run typecheck
bun run typecheck:ui

# Biome: lint + format + import sorting. Fails on rules violations.
echo "▶ biome (lint + format)"
bun run check:all

# Unit tests plus a deterministic coverage threshold gate.
echo "▶ tests with coverage"
bun run test:coverage

echo "── kanban: quality gate passed ──"
